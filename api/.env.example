# ─────────────────────────────────────────────────────────────────
# Modelo de configuração. Copie para `.env` e preencha lá.
# ESTE arquivo vai para o repositório; o `.env` NUNCA vai.
# Nenhum valor real deve aparecer aqui — só o nome e o formato.
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Banco ────────────────────────────────────────────────────────
# A senha do Supabase mora AQUI e só aqui. As duas URLs abaixo a
# referenciam com ${MINHASENHA}: rotacionar a senha é editar uma linha,
# não duas — e duas é onde se esquece uma.
#
# Escreva a senha CRUA, exatamente como no painel. Não codifique nada:
# src/config/carregar-env.ts faz o percent-encoding ao montar a URL.
MINHASENHA=

# Project Settings › Database › Connection string.
# Copie do painel e troque SEU_REF / SUA-REGIAO pelos do seu projeto.
# Onde o painel mostra [YOUR-PASSWORD], já está ${MINHASENHA}.
#   6543 = pooler (transaction), para a API
#   5432 = direta, para migração — o pooler não aceita DDL preparado
DATABASE_URL=postgresql://postgres.SEU_REF:${MINHASENHA}@aws-0-SUA-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRETA=postgresql://postgres:${MINHASENHA}@db.SEU_REF.supabase.co:5432/postgres

# Supabase — Project Settings › API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Só no servidor. Esta chave ignora Row-Level Security:
# se vazar, vaza o banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=

# ── Lojas ────────────────────────────────────────────────────────
# Preencher conforme cada cadastro de afiliado for aprovado.
# Enquanto vazio, o conector correspondente fica desligado sozinho.

SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=

AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

KEEPA_API_KEY=

# Identificação do nosso coletor. Loja séria quer saber quem está batendo.
COLETOR_USER_AGENT=AptumBot/0.1 (+https://aptum.app/bot)
COLETOR_CONTATO=
