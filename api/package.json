{
  "name": "@aptum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/api/servidor.ts",
    "coletar": "node --experimental-strip-types src/coleta/executar.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "db:gerar": "drizzle-kit generate",
    "db:aplicar": "node --experimental-strip-types src/db/migrar.ts",
    "db:estudio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3"
  }
}
